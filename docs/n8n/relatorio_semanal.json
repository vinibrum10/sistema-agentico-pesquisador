{
  "name": "SAP-5 — relatório semanal (INATIVO; revisão operacional pendente)",
  "active": false,
  "nodes": [
    {
      "id": "segunda-08h",
      "name": "Segunda 08h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "manual",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "gerar",
      "name": "Gerar",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "executeOnce": true,
        "command": "python -B /opt/sap/scripts/gerar_relatorio_semanal.py --dados /dados-pessoais/active_research --sha-origem PREENCHER_SHA_40_HEX --formato json"
      }
    },
    {
      "id": "preparar",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const exec = $input.first().json;\nif (Number(exec.exitCode) !== 0) throw new Error('Falha do gerador; publicação interrompida');\nconst r = JSON.parse(exec.stdout);\nconst folderId = 'PREENCHER_ID_PASTA_PESSOAL';\nif (!/^[A-Za-z0-9_-]+$/.test(folderId) || folderId.startsWith('PREENCHER')) throw new Error('Pasta pessoal pendente de aprovação');\nif (r.schema_version !== 1 || !/^sap-semanal_\\d{4}-\\d{2}-\\d{2}_\\d{4}-\\d{2}-\\d{2}\\.md$/.test(r.nome) || typeof r.markdown !== 'string' || !/^[a-f0-9]{40}$/.test(r.sha_origem)) throw new Error('Contrato inválido do relatório');\nreturn [{json: {folderId, nome: r.nome, markdown: r.markdown, sha: r.sha_origem, query: \"'\" + folderId + \"' in parents and trashed = false and name = '\" + r.nome + \"'\"}}];"
      }
    },
    {
      "id": "buscar",
      "name": "Buscar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {},
        "url": "https://www.googleapis.com/drive/v3/files",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "pageSize",
              "value": "2"
            },
            {
              "name": "fields",
              "value": "files(id,name,mimeType),nextPageToken,incompleteSearch"
            }
          ]
        }
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "decidir",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const resposta = $input.first().json;\nconst r = $('Preparar').first().json;\nif (!Array.isArray(resposta.files) || resposta.nextPageToken || resposta.incompleteSearch || resposta.files.length > 1) throw new Error('Busca inconclusiva ou duplicação; corrigir manualmente antes de publicar');\nconst arquivo = resposta.files[0];\nif (arquivo && (!/^[A-Za-z0-9_-]+$/.test(arquivo.id) || arquivo.mimeType !== 'text/markdown')) throw new Error('Arquivo existente incompatível');\nreturn [{json: {...r, existe: Boolean(arquivo), id: arquivo ? arquivo.id : ''}}];"
      }
    },
    {
      "id": "existe",
      "name": "Existe",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "existe",
              "leftValue": "={{ $json.existe }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "criar-metadados",
      "name": "Criar metadados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {},
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({name: $json.nome, mimeType: 'text/markdown', parents: [$json.folderId]}) }}"
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "identificar",
      "name": "Identificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "const id = $input.first().json.id;\nif (typeof id !== 'string' || !/^[A-Za-z0-9_-]+$/.test(id)) throw new Error('ID ausente após criar/localizar arquivo');\nreturn [{json: {id}}];"
      }
    },
    {
      "id": "atualizar-conteudo",
      "name": "Atualizar conteudo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {},
        "method": "PATCH",
        "url": "={{ 'https://www.googleapis.com/upload/drive/v3/files/' + $json.id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "uploadType",
              "value": "media"
            },
            {
              "name": "fields",
              "value": "id"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/markdown; charset=utf-8",
        "body": "={{ $('Preparar').first().json.markdown }}"
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "confirmar",
      "name": "Confirmar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "jsCode": "const id = $input.first().json.id;\nif (typeof id !== 'string' || !/^[A-Za-z0-9_-]+$/.test(id)) throw new Error('Publicação sem confirmação de ID');\nreturn [{json: {status: 'publicado', nome: $('Preparar').first().json.nome, sha: $('Preparar').first().json.sha, id, link: 'https://drive.google.com/file/d/' + id + '/view'}}];"
      }
    }
  ],
